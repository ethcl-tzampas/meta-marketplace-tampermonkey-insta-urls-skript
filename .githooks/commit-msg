#!/bin/sh
# Prueft die Commit-Nachricht auf personenbezogene und interne Daten.
if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node fehlt — ohne Pruefung wird nicht committet." >&2
  exit 1
fi
node "$(git rev-parse --show-toplevel)/tools/datenpruefung.mjs" --nachricht "$1" || exit 1
